<Project Sdk="Microsoft.NET.Sdk">
  <!-- Causa's application shell behind the Limen kernel: routes, navigation, the presentation-language mapping and
       the projection to the view the kernel binds. Investigation meaning comes through the Port (Adapter.fs) from
       the F# engine and persistence; this project decides only what is shown and where. -->
  <PropertyGroup>
    <AssemblyName>Causa.App</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Limen.Contract" Version="0.9.0" />
    <PackageReference Include="EchelonFoundry.Limen.Guest" Version="0.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core kernel (Boundaries A, B, E; docs/architecture/BOUNDARIES.md). -->
    <ProjectReference Include="../engine/App.Engine.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Routes.fs" />
    <Compile Include="Adapter.fs" />
    <Compile Include="Presentation.fs" />
    <Compile Include="Graph.fs" />
    <Compile Include="EngineView.fs" />
    <Compile Include="EnginePort.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="TestState.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Dispatch.fs" />
  </ItemGroup>
</Project>
