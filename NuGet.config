<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Limen's F# packages are GitHub release assets (echelon-registry releases/limen-fsharp/0.9.0), vendored here
       and pinned by vendor/nuget/limen-fsharp.lock. Everything else comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="echelon-vendor" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="echelon-vendor">
      <package pattern="EchelonFoundry.Limen.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
